# App
APP_ENV=local
APP_TIMEZONE=Asia/Seoul
API_TOKEN=change-me
DATA_DIR=data

# Trading
PAPER_TRADING=true
TRADING_ENABLED=false
KILL_SWITCH=true
LIVE_MANUAL_ORDER_ENABLED=false
LIVE_AUTO_ORDER_ENABLED=false
UPBIT_LIVE_ORDER_ENABLED=false
TOSS_LIVE_ORDER_ENABLED=false
# Toss requires explicit confirmation for high-value orders. Keep false until intentionally enabled.
TOSS_CONFIRM_HIGH_VALUE_ORDERS=false
TOSS_HIGH_VALUE_ORDER_THRESHOLD_KRW=100000000
LIVE_ORDER_RECONCILE_ATTEMPTS=3
LIVE_ORDER_RECONCILE_INTERVAL_SECONDS=1

# Risk Guard hard limits (initial defaults; tune after Paper operation)
RISK_MAX_POSITION_PCT=60
RISK_MAX_DAILY_LOSS_PCT=3
RISK_MAX_DAILY_ORDERS=20
RISK_MAX_DATA_AGE_SECONDS=300
RISK_MIN_CASH_RESERVE_PCT=10
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=90
RISK_MAX_OPEN_POSITIONS=10
RISK_AUTO_SYMBOL_COOLDOWN_MINUTES=60
RISK_SELL_REENTRY_COOLDOWN_MINUTES=60
RISK_STOP_REENTRY_COOLDOWN_MINUTES=180
RISK_HARD_STOP_LOSS_PCT=5
RISK_TRAILING_ACTIVATION_PCT=10
RISK_TRAILING_STOP_PCT=5
RISK_MONITOR_INTERVAL_MINUTES=5
RISK_BUY_KILL_SWITCH=false

# Deterministic Position Sizer
POSITION_BUY_MIN_SCORE=60
POSITION_SELL_MAX_SCORE=40
POSITION_BUY_PCT_SCORE_60=5
POSITION_BUY_PCT_SCORE_70=10
POSITION_BUY_PCT_SCORE_80=15
POSITION_BUY_PCT_SCORE_90=20
POSITION_SELL_PCT_SCORE_40=25
POSITION_SELL_PCT_SCORE_30=40
POSITION_SELL_PCT_SCORE_20=60
POSITION_REGIME_BULL_MIN_SCORE=60
POSITION_REGIME_BEAR_MAX_SCORE=40
POSITION_REGIME_THRESHOLD_SHIFT=5
POSITION_TARGET_EXPOSURE_BULL_PCT=80
POSITION_TARGET_EXPOSURE_NEUTRAL_PCT=60
POSITION_TARGET_EXPOSURE_BEAR_PCT=35

# Paper broker
PAPER_STOCK_INITIAL_CASH_KRW=1000000
PAPER_CRYPTO_INITIAL_CASH_KRW=1000000
PAPER_FEE_BPS=0
PAPER_SLIPPAGE_BPS=0
DECISION_DEFAULT_INTERVAL_MINUTES=60
DECISION_STOCK_UNIVERSE_LIMIT=25
DECISION_CRYPTO_UNIVERSE_LIMIT=20
DECISION_MIN_INTERVAL_MINUTES=30
DECISION_MAX_INTERVAL_MINUTES=120
NEWS_COLLECTION_INTERVAL_HOURS=12
NEWS_WEB_SEARCH_ENABLED=true
NEWS_MAX_OUTPUT_TOKENS=2500

# Structured macro market context (FRED)
FRED_API_KEY=
FRED_API_BASE_URL=https://api.stlouisfed.org/fred
MACRO_CONTEXT_MAX_AGE_HOURS=48

# KRX official Open API (approved key; backend only)
KRX_API_KEY=
KRX_API_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
KRX_HTTP_TIMEOUT_SECONDS=8
SCHEDULER_ENABLED=false
DATA_RETENTION_DAYS=7
IDEMPOTENCY_RETENTION_DAYS=30
STARTUP_PUSH_ENABLED=false
MAX_DAILY_ORDERS=20
MAX_DAILY_LOSS_PCT=3

# OpenAI / LLM budget
OPENAI_API_KEY=
# Admin key is required for official organization Usage/Costs sync.
OPENAI_ADMIN_KEY=
# Optional project filter. Empty = whole organization.
OPENAI_PROJECT_ID=
OPENAI_DECISION_MODEL=gpt-5.6-terra
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=8000
LLM_ENABLED=true
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_CYCLE_INPUT_TOKEN_LIMIT=12000
LLM_CONTEXT_NEWS_CHARS=12000
LLM_CONTEXT_DECISION_CHARS=6000
LLM_CONSERVE_THRESHOLD_PCT=20
ALGORITHM_REVIEW_INTERVAL_HOURS=24
ALGORITHM_REVIEW_MIN_DECISIONS=20

# Upbit
# Public quotation API does not require keys.
# Private balance/order APIs will use the keys later.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_API_BASE_URL=https://api.upbit.com/v1
# Comma-separated decision universe. Empty = scheduler does not auto-run crypto.
# Example: KRW-BTC,KRW-ETH
UPBIT_DECISION_MARKETS=
UPBIT_HTTP_TIMEOUT_SECONDS=8

# Toss Securities Open API
# OAuth2 Client Credentials. Keep secrets on backend only.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
# Optional. Required when more than one eligible account exists.
TOSS_ACCOUNT_SEQ=
# Comma-separated Korean stock decision universe, used only as initial value.
# Example: 005930,000660
TOSS_DECISION_SYMBOLS=
TOSS_HTTP_TIMEOUT_SECONDS=8

# Legacy generic Korea broker envs (unused by new Toss adapter)
KOREA_BROKER_APP_KEY=
KOREA_BROKER_APP_SECRET=
KOREA_BROKER_ACCOUNT_NO=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FCM_DEVICE_TOKEN=
